  "assets": {
    "background": {
      "method": "built-in image_gen",
      "useCase": "precise-object-edit",
      "prompt": "Use case: precise-object-edit. Edit target: attached reference screenshot. Create a clean reusable BACKGROUND-ONLY illustration asset for a responsive website hero, wide 2.12:1 canvas. Remove every Japanese heading, the white rounded heading capsule, underline, all TELEMO 3D letters and their shadow, the white speech balloon and its text, the small photoreal man at lower right, and both buttons. Inpaint those regions into the office illustration. Preserve the rest of this exact artwork and composition as faithfully as possible: mint and pale aqua sweeping wall, two teal pendant lamps in upper left with warm yellow inner lights, call center employees with headsets and teal monitors along the lower edge, a supervisor behind the woman in lower left, two colleagues conversing at upper right, plants and windows on both edges, tiny yellow desk accents, softly textured pastel illustrated style. The top center and middle left must stay very light and empty for HTML headings and a separately overlaid logo. The middle right should also stay light for a separately overlaid speech balloon. Extend the pale mint wall naturally into all removed text areas. No text, no typography, no logos, no buttons, no speech shapes, no photographic person. Output only the wide finished office background.",
      "conversion": "sips JPEG quality 90"
    },
    "wordmark": "existing",
    "president": "existing",
    "speech": "existing"
  },
