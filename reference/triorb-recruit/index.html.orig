            <h3 id="guidelines-category-manufacturing" class="ja-label-b py-9">製造部門</h3>

                          <ul class="flex flex-col gap-y-5">
                                                    <li>
                      <a href="https://recruit.triorb.co.jp/guidelines/%e6%a9%9f%e6%a2%b0%e8%a8%ad%e8%a8%88%e3%82%a8%e3%83%b3%e3%82%b8%e3%83%8b%e3%82%a2%ef%bc%88%e8%a9%a6%e4%bd%9c%e2%86%92%e9%87%8f%e7%94%a3%e4%b8%80%e8%b2%ab%ef%bc%89/" class="group md:pr-26 text-my-black relative bg-my-white px-5 py-8 md:p-8 rounded-[8px] block">

