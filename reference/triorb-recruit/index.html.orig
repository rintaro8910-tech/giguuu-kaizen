  <script>
    (function() {
      try {
        var sessionKey = "triorb:home-loading-seen";
        // 「ホームをこのタブで一度表示済み」または hash 付き初回なら early skip する。
        var shouldSkip = Boolean(window.location.hash);
        if (!shouldSkip) {
          shouldSkip = window.sessionStorage.getItem(sessionKey) === "1";
        }
        if (shouldSkip) {
          document.documentElement.setAttribute("data-skip-home-loading", "1");
        }
      } catch (error) {}
    })();
  </script>
