    </style>
    <script>
      (function() {
        var guardAttribute = 'data-home-reload-scroll-guard';

        try {
          var navigationEntries = window.performance.getEntriesByType('navigation');
          var isReload = navigationEntries.length > 0 &&
            navigationEntries[0].type === 'reload';

          if (!isReload && window.performance.navigation) {
            isReload = window.performance.navigation.type === 1;
          }

          if (!isReload) return;

          var root = document.documentElement;
          var fallbackTimer = 0;
          var removeGuard = function() {
            root.removeAttribute(guardAttribute);
            if (fallbackTimer) {
              window.clearTimeout(fallbackTimer);
              fallbackTimer = 0;
            }
          };
          var removeGuardAfterPaint = function() {
            window.requestAnimationFrame(function() {
              window.requestAnimationFrame(removeGuard);
            });
          };

          root.setAttribute(guardAttribute, '1');
          window.addEventListener('pageshow', removeGuardAfterPaint, {
            once: true
          });
          fallbackTimer = window.setTimeout(removeGuard, 5000);
        } catch (error) {
          document.documentElement.removeAttribute(guardAttribute);
        }
      })();
    </script>
